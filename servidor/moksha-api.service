[Unit]
Description=MOKSHA API (contas, personagem e progresso)
After=network.target postgresql.service

[Service]
Type=simple
User=moksha
Group=moksha
WorkingDirectory=/opt/moksha-api
EnvironmentFile=/etc/moksha-api.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
