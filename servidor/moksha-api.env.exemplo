# Copiar para /etc/moksha-api.env (root:moksha, modo 640) e preencher.
PORT=3310
SITE_URL=https://moksha.com.br
DATABASE_URL=postgres://moksha:SENHA_DO_BANCO@127.0.0.1:5432/moksha

# E-mail para "esqueci a senha". Sem SMTP_HOST o link só aparece em
# journalctl -u moksha-api.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MOKSHA <nao-responda@moksha.com.br>

# Quem vê o painel em /admin.html (e-mails das contas, separados por vírgula)
ADMIN_EMAILS=
# Opcional: cada feedback também vai para este canal do Discord
DISCORD_WEBHOOK=

# Loja (moksha.com.br/loja.html): Access Token de PRODUÇÃO do Mercado Pago
# (Suas integrações > Credenciais). Vazio = a vitrine aparece, mas a compra fica fechada.
MP_ACCESS_TOKEN=
